# Copy this file to ".env" for local development. NEVER commit ".env".
# On Render, set these in the dashboard (or via render.yaml), not in a file.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
# On Render this is filled in automatically by render.yaml.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Set to "true" only when connecting from outside Render's private network
# (for example from your own computer to Render's external database URL).
DATABASE_SSL=false

# "true" = on startup, insert the labelled placeholder listings, but only
# if the products table is completely empty. Set to "false" once you have
# added your real listings.
SEED_PLACEHOLDERS=true
